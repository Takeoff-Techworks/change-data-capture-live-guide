# Copy to .env and edit. All values are optional; defaults shown below.

# Label for the environment (informational only).
APP_ENV=development

# SQLAlchemy database URL. Default is a local SQLite file.
# Example: sqlite:///./northstar.db
APP_DATABASE_URL=sqlite:///./northstar.db

# How CDC events arrive. "simulated" needs no Docker or Kafka.
# Other values are reported as the consumer mode in diagnostics (e.g. debezium).
CDC_MODE=simulated

# true/false: process CDC events automatically as they arrive.
CDC_AUTO_PROCESS=true

# Milliseconds of artificial delay before projection, to make freshness lag visible.
CDC_ARTIFICIAL_DELAY_MS=500

# true/false: pause the consumer so events queue up (demo stale data).
CDC_CONSUMER_PAUSED=false

# Failure injection for demos:
#   none                      - no failures
#   projection_once           - fail the next projection once, then reset to none
#   always_fail_table:<name>  - always fail events from that source table
#                               (e.g. always_fail_table:appointments) -> dead-letter queue
CDC_FAILURE_MODE=none

# Assistant provider: "deterministic" (default, no key needed), "gemini", or "openai".
ASSISTANT_PROVIDER=openai

# Gemini (used only when ASSISTANT_PROVIDER=gemini).
# Set either key; GOOGLE_API_KEY takes precedence.
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Any Gemini model name supported by langchain-google-genai.
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (used only when ASSISTANT_PROVIDER=openai).
OPENAI_API_KEY=
# Optional. Leave empty for api.openai.com. For Microsoft Foundry / Azure OpenAI use
# https://<resource>.openai.azure.com/openai/v1/ (and set OPENAI_MODEL to your deployment name).
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-terra

# true/false: reset seed data every time the app starts.
DEMO_RESET_ON_START=false

# Optional LangChain tracing settings.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
