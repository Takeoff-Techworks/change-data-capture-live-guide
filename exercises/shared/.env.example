# Which model the notebooks use: gemini (default) or openai
LLM_PROVIDER=gemini

# Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional. Leave empty for api.openai.com. For Microsoft Foundry use
# https://<resource>.openai.azure.com/openai/v1/ and set OPENAI_MODEL to your deployment name.
OPENAI_BASE_URL=
